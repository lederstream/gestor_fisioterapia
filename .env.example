# ==============================================================================
# KineFlow Core - Configuración de Entorno (AJ Fisioterapia - San Borja)
# ==============================================================================

# Conexión a Base de Datos PostgreSQL (Supabase / Neon / AWS RDS)
# Reemplazar con tu cadena de conexión real (con pooling para serverless en Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Entorno de ejecución
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Autenticación y Seguridad (Supabase Auth / NextAuth / JWT)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
NEXTAUTH_SECRET="super-secret-random-32-chars-string"
NEXTAUTH_URL="http://localhost:3000"

# Parámetros del Centro Clínico
NEXT_PUBLIC_CLINIC_NAME="AJ Fisioterapia"
NEXT_PUBLIC_CLINIC_BRANCH="San Borja - Av. Guardia Civil 520"
NEXT_PUBLIC_TOTAL_SALAS="6"

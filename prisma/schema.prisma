// Gestor Fisioterapia - Schema Relacional AJ Fisioterapia (San Borja)
// Desarrollado por Marco Antonio Yana

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  RECEPCION
  TERAPEUTA
  PACIENTE
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoSala {
  DISPONIBLE
  MANTENIMIENTO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  POS
}

enum EstadoVerificacionPago {
  VERIFICADO
  PENDIENTE
}

// 1. Personal y Usuarios del Sistema (RBAC)
model User {
  id           String        @id @default(uuid())
  nombre       String
  email        String        @unique
  rol          Rol           @default(TERAPEUTA)
  especialidad String?       // Ej: "Lic. Fisioterapia Deportiva", "Lic. Neurorehabilitación", "Técnico"
  estado       EstadoUsuario @default(ACTIVO)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relaciones
  citasAsignadas      Cita[]              @relation("TerapeutaCitas")
  historiasEvolucion  HistoriaEvolucion[] @relation("TerapeutaEvolucion")

  @@index([rol, estado])
  @@map("users")
}

// 2. Pacientes
model Paciente {
  id                         String    @id @default(uuid())
  tipoDocumento              String    @default("DNI") @map("tipo_documento")
  dni                        String    @unique // DNI peruano (8 dígitos) o documento de identidad
  primerNombre               String?   @map("primer_nombre")
  segundoNombre              String?   @map("segundo_nombre")
  apellidoPaterno            String?   @map("apellido_paterno")
  apellidoMaterno            String?   @map("apellido_materno")
  nombres                    String
  apellidos                  String
  telefono                   String
  email                      String?
  fechaNacimiento            DateTime  @map("fecha_nacimiento")
  contactoEmergenciaNombre   String?   @map("contacto_emergencia_nombre")
  contactoEmergenciaParentesco String? @map("contacto_emergencia_parentesco")
  contactoEmergenciaTelefono String?   @map("contacto_emergencia_telefono")
  contactoEmergencia         String?   @map("contacto_emergencia")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  // Relaciones
  tratamientos TratamientoPaquete[]
  citas        Cita[]

  @@index([dni])
  @@index([apellidos, nombres])
  @@map("pacientes")
}

// 3. Salas Físicas (Capacidad operativa: 6 salas en San Borja)
model Sala {
  id        String     @id @default(uuid())
  nombre    String     @unique // "Sala 1" a "Sala 6"
  estado    EstadoSala @default(DISPONIBLE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relaciones
  citas Cita[]

  @@map("salas")
}

// 4. Servicios Clínicos
model Servicio {
  id                String   @id @default(uuid())
  nombre            String   // Ej: "Terapia física", "Rehabilitación deportiva"
  categoriaTag      String?  @default("DOLOR & MOVILIDAD") @map("categoria_tag")
  descripcion       String?  @db.Text
  duracionMinutos   Int      @default(45) @map("duracion_minutos")
  precioBase        Decimal  @map("precio_base") @db.Decimal(10, 2)
  precioPromocional Decimal? @map("precio_promocional") @db.Decimal(10, 2)
  textoPromocion    String?  @map("texto_promocion")
  imagenUrl         String?  @map("imagen_url")
  mostrarEnWeb      Boolean  @default(true) @map("mostrar_en_web")
  orden             Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relaciones
  tratamientosPaquetes TratamientoPaquete[]

  @@map("servicios")
}

// 5. Tratamientos y Paquetes (1, 10, 20 sesiones con pagos fraccionados)
model TratamientoPaquete {
  id                 String     @id @default(uuid())
  pacienteId         String     @map("paciente_id")
  servicioId         String     @map("servicio_id")
  totalSesiones      Int        @default(10) @map("total_sesiones") // 1, 10, 20
  sesionesConsumidas Int        @default(0) @map("sesiones_consumidas")
  montoTotal         Decimal    @map("monto_total") @db.Decimal(10, 2)
  montoPagado        Decimal    @default(0) @map("monto_pagado") @db.Decimal(10, 2)
  estadoPago         EstadoPago @default(PENDIENTE) @map("estado_pago")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  // Relaciones
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  servicio Servicio @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  citas    Cita[]
  pagos    Pago[]

  @@index([pacienteId, estadoPago])
  @@map("tratamientos_paquetes")
}

// 6. Citas
model Cita {
  id              String     @id @default(uuid())
  paqueteId       String?    @map("paquete_id")
  terapeutaId     String     @map("terapeuta_id")
  salaId          String     @map("sala_id")
  pacienteId      String     @map("paciente_id")
  fechaHoraInicio DateTime   @map("fecha_hora_inicio")
  fechaHoraFin    DateTime   @map("fecha_hora_fin")
  estado          EstadoCita @default(PROGRAMADA)
  esReevaluacion  Boolean    @default(false) @map("es_reevaluacion") // Regla clínica cada 5 sesiones
  notasCita       String?    @map("notas_cita") @db.Text
  creadoPorNombre String?    @map("creado_por_nombre")
  confirmadoPorNombre String? @map("confirmado_por_nombre")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relaciones
  paquete           TratamientoPaquete? @relation(fields: [paqueteId], references: [id], onDelete: SetNull)
  terapeuta         User                @relation("TerapeutaCitas", fields: [terapeutaId], references: [id], onDelete: Restrict)
  sala              Sala                @relation(fields: [salaId], references: [id], onDelete: Restrict)
  paciente          Paciente            @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  historiaEvolucion HistoriaEvolucion?

  // Restricciones de Integridad y Concurrencia (Unicidad compuestas e índices para solapamiento)
  @@unique([salaId, fechaHoraInicio], name: "sala_horainicio_unique")
  @@unique([terapeutaId, fechaHoraInicio], name: "terapeuta_horainicio_unique")
  @@index([salaId, fechaHoraInicio, fechaHoraFin])
  @@index([terapeutaId, fechaHoraInicio, fechaHoraFin])
  @@index([pacienteId, fechaHoraInicio])
  @@index([fechaHoraInicio, estado])
  @@map("citas")
}

// 7. Pagos y Cobranzas
model Pago {
  id              String                 @id @default(uuid())
  paqueteId       String                 @map("paquete_id")
  monto           Decimal                @db.Decimal(10, 2)
  metodoPago      MetodoPago             @map("metodo_pago")
  numeroOperacion String?                @unique @map("numero_operacion")
  comprobanteUrl  String?                @map("comprobante_url")
  estado          EstadoVerificacionPago @default(VERIFICADO)
  fechaPago       DateTime               @default(now()) @map("fecha_pago")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  // Relaciones
  paquete TratamientoPaquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)

  @@index([paqueteId, estado])
  @@index([fechaPago])
  @@map("pagos")
}

// 8. Ficha Clínica / Historia de Evolución (Estricta privacidad, sin multimedia)
model HistoriaEvolucion {
  id                 String   @id @default(uuid())
  citaId             String   @unique @map("cita_id")
  terapeutaId        String   @map("terapeuta_id")
  evaDolorInicio     Int      @map("eva_dolor_inicio") // Escala EVA 0 a 10
  evaDolorFin        Int      @map("eva_dolor_fin")    // Escala EVA 0 a 10
  tratamientoAplicado String  @map("tratamiento_aplicado") @db.Text
  notasReevaluacion  String?  @map("notas_reevaluacion") @db.Text
  bloqueaAlta        Boolean  @default(false) @map("bloquea_alta") // Bloqueo si requiere reevaluación pendiente
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relaciones
  cita      Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)
  terapeuta User @relation("TerapeutaEvolucion", fields: [terapeutaId], references: [id], onDelete: Restrict)

  @@index([terapeutaId])
  @@map("historia_evolucion")
}

// 9. Registro de Auditoría y Trazabilidad Médica y Financiera (Audit Trail)
model AuditLog {
  id            String   @id @default(uuid())
  usuarioId     String?  @map("usuario_id")
  usuarioNombre String   @default("Sistema") @map("usuario_nombre")
  usuarioRol    Rol      @default(ADMIN) @map("usuario_rol")
  accion        String   // "CITA_CREADA", "CITA_CANCELADA", "PAGO_REGISTRADO", "ASISTENCIA_REGISTRADA", "REEVALUACION_ACREDITADA", "CONFIGURACION_MODIFICADA"
  modulo        String   // "AGENDA", "CAJA", "HISTORIA_CLINICA", "CONFIGURACION", "SISTEMA"
  entidadId     String?  @map("entidad_id")
  detalles      String   @db.Text
  ipAddress     String?  @default("127.0.0.1") @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([modulo, accion])
  @@index([usuarioId])
  @@map("audit_logs")
}

// 10. Configuración Maestra del Centro Clínico (Marca Blanca)
model ConfiguracionClinica {
  id                     String   @id @default("config-principal")
  razonSocial            String   @default("AJ Fisioterapia S.A.C.") @map("razon_social")
  nombreComercial        String   @default("AJ Fisioterapia") @map("nombre_comercial")
  slogan                 String?  @default("REHABILITACIÓN & BIENESTAR")
  tituloHero             String?  @default("Vuelve a moverte.") @map("titulo_hero")
  subtituloHero          String?  @default("Vuelve a sentirte tú.") @map("subtitulo_hero")
  descripcionHero        String?  @default("Fisioterapia especializada y humana para recuperar tu bienestar, paso a paso.") @map("descripcion_hero") @db.Text
  ruc                    String   @default("20608912345")
  direccion              String   @default("Av. Guardia Civil 520, San Borja, Lima")
  direccionAvenidaCalle  String?  @default("Av. Guardia Civil") @map("direccion_avenida_calle")
  direccionNumero        String?  @default("520") @map("direccion_numero")
  direccionDistrito      String?  @default("San Borja") @map("direccion_distrito")
  direccionCiudad        String?  @default("Lima") @map("direccion_ciudad")
  direccionReferencia    String?  @default("A 2 cuadras de Av. Javier Prado Este") @map("direccion_referencia")
  telefono               String   @default("(01) 475-2010")
  whatsapp               String   @default("+51 987 654 321")
  googleMapsUrl          String?  @map("google_maps_url")
  horaApertura           String   @default("08:00") @map("hora_apertura")
  horaCierre             String   @default("20:00") @map("hora_cierre")
  intervaloMinutos       Int      @default(45) @map("intervalo_minutos")
  frecuenciaReevaluacion Int      @default(5) @map("frecuencia_reevaluacion")
  bloqueoAltaReevaluacion Boolean @default(true) @map("bloqueo_alta_reevaluacion")
  totalSalasFisicas      Int      @default(6) @map("total_salas_fisicas")
  horariosSemana         Json?    @map("horarios_semana")
  testimonios            Json?
  ratingPromedio         Decimal? @default(4.9) @map("rating_promedio") @db.Decimal(3, 1)
  totalPacientesMes      String?  @default("+1,100") @map("total_pacientes_mes")
  logoUrl                String?  @map("logo_url")
  faviconUrl             String?  @map("favicon_url")
  heroImageUrl           String?  @default("/images/hero-physio.jpg") @map("hero_image_url")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("configuracion_clinica")
}

